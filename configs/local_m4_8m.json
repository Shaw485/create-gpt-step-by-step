{
  "schema_version": "local-pretrain-v4/v1",
  "config_version": "1.0.0",
  "seed": 42,
  "device": "mps",
  "data_dir": "data/cloud_v4",
  "run_dir": "runs/pretrain_v4_m4",
  "model": {
    "block_size": 512,
    "embedding_size": 256,
    "num_layers": 8,
    "num_heads": 8,
    "ffn_multiplier": 4,
    "dropout": 0.1,
    "tie_embeddings": true
  },
  "training": {
    "max_steps": 3000,
    "micro_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "tokens_per_optimizer_step": 4096,
    "precision": "float32",
    "learning_rate": 0.0003,
    "minimum_learning_rate": 0.00003,
    "warmup_steps": 100,
    "weight_decay": 0.1,
    "betas": [0.9, 0.95],
    "gradient_clip_norm": 1.0,
    "log_interval": 10,
    "eval_interval": 100,
    "eval_batches": 20,
    "checkpoint_interval": 100,
    "sample_interval": 500,
    "sample_max_characters": 30,
    "early_stopping_patience": 10,
    "early_stopping_min_delta": 0.002
  },
  "generation": {
    "temperature": 0.8,
    "top_k": 40,
    "max_new_tokens": 96
  },
  "logging": {
    "max_bytes": 10485760,
    "backup_count": 5,
    "console": true,
    "module_levels": {
      "preflight": "INFO",
      "data": "INFO",
      "pretrain": "INFO",
      "validation": "INFO",
      "checkpoint": "INFO",
      "gpu": "INFO",
      "sft": "OFF",
      "orchestrator": "INFO"
    }
  }
}
